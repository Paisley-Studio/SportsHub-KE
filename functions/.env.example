# Copy to functions/.env for your live project. Never commit the copy.

# The account allowed to run first-time setup at /setup/ and become Super Administrator.
SUPERADMIN_EMAIL=you@example.com

# Set to true only while testing before a real payment provider is installed.
# It lets accounts activate membership without money. Never use it with real users.
# ALLOW_SIMULATED_PAYMENTS=true

# When M-Pesa is installed:
# PAYMENT_PROVIDER=mpesa
# MPESA_CALLBACK_TOKEN=choose-a-long-random-value

# File storage: Cloudflare R2 (Firebase Storage is not used).
# Cloudflare dashboard > R2 > create bucket, then Manage R2 API Tokens (Object Read & Write on that bucket).
# R2_PUBLIC_BASE is the bucket's public address: its r2.dev URL or your custom domain, without a trailing slash.
# The bucket's CORS policy must allow PUT from your site's origin with the Content-Type header.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=sportshub-media
R2_PUBLIC_BASE=https://media.example.com
